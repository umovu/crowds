# =============================================================
# MiroFish-Offline Configuration
# =============================================================
# This fork runs entirely on local models — no cloud APIs needed.
# Copy this file to .env and adjust values for your setup.
# =============================================================

# ===== LLM Configuration (OpenAI-compatible format) =====
# Points to local Ollama server. Any non-empty value for API key works.
# For Docker: use service name "ollama" instead of "localhost"
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=gemma4:e2b
# Lighter model for development (less VRAM):
# LLM_MODEL_NAME=qwen2.5:14b

# --- Groq free tier (500 req/day, fast inference, no local GPU needed) ---
# Get key at console.groq.com
# LLM_API_KEY=your-groq-api-key
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL_NAME=llama-3.1-8b-instant        # cheapest, fastest
# LLM_MODEL_NAME=llama-3.3-70b-versatile      # better quality, fewer tokens/min
# OPENAI_API_KEY=your-groq-api-key
# OPENAI_API_BASE_URL=https://api.groq.com/openai/v1

# --- Gemini free tier (1500 req/day, 1M tokens/day via Google AI Studio) ---
# Get key at aistudio.google.com/apikey
# LLM_API_KEY=your-gemini-api-key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL_NAME=gemini-1.5-flash             # best free-tier value
# OPENAI_API_KEY=your-gemini-api-key
# OPENAI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Note: for embeddings with Gemini you still need Ollama or set EMBEDDING_BASE_URL separately

# ===== Neo4j Configuration =====
# For Docker: use service name "neo4j" instead of "localhost"
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mirofish

# ===== Embedding Configuration =====
# Uses Ollama's embedding endpoint
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434
# For Docker: EMBEDDING_BASE_URL=http://ollama:11434

# ===== OASIS / CAMEL-AI Configuration =====
# CAMEL-AI reads OPENAI_API_KEY and OPENAI_API_BASE_URL
# Points to same local Ollama server
OPENAI_API_KEY=ollama
OPENAI_API_BASE_URL=http://localhost:11434/v1

# ===== Simulation Context (set to match the population being simulated) =====
# Single country or comma-separated list — randomly assigned to individual agents
SIMULATION_COUNTRIES=South Africa
# Fixed country for institutional agents (government, NGOs, universities, media)
SIMULATION_DEFAULT_COUNTRY=South Africa

# ===== Token Budget Controls (tune these to stay within free tier limits) =====
# Cap agents to avoid burning through quota on persona generation
MAX_SIMULATION_AGENTS=30
# Larger chunks = fewer NER extraction calls (tradeoff: less granular graph)
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
# Report agent: fewer reflection rounds and tool calls = fewer LLM calls
REPORT_AGENT_MAX_TOOL_CALLS=2
REPORT_AGENT_MAX_REFLECTION_ROUNDS=0

# ===== Docker-mode overrides =====
# Uncomment these when running ALL services inside Docker
# (backend container talks to neo4j/ollama containers by service name)
# LLM_BASE_URL=http://ollama:11434/v1
# NEO4J_URI=bolt://neo4j:7687
# EMBEDDING_BASE_URL=http://ollama:11434
# OPENAI_API_BASE_URL=http://ollama:11434/v1
