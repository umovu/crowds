      "type": "boolean",
      "allowed": [
        true
      ],
      "db": "boolean",
      "when": "always",
      "note": "Primary key fixed at true, so only one row can exist."
    },
    "invite_only": {
      "type": "boolean",
      "db": "boolean",
      "when": "always"
    },
    "updated_at": {
      "type": "string",
      "db": "timestamptz",
      "when": "always"
    }
  }
}
