{
  "version": 1,
  "about": "One dated, sourced claim about current South African conditions, as held in a context snapshot.",
  "stored_in": "DATA_ROOT/sa_context_snapshot.json -> claims[] (or the cache's claims form)",
  "written_by": [
    "the SA context refresh (snapshot)"
  ],
  "read_by": [
    "sa_context.format_snapshot",
    "sa_context.detect_conflicts"
  ],
  "rules": [
    "A claim past expires_at is dropped from prompts."
  ],
  "fields": {
    "text": {
      "type": "string",
      "min_length": 1,
      "when": "always"
    },
    "date": {
      "type": "string",
      "when": "optional"
    },
    "source": {
      "type": "string",
      "when": "optional"
    },
    "scope": {
      "type": "string",
      "when": "optional"
    },
    "expires_at": {
      "type": "number",
      "nullable": true,
      "when": "optional"
    }
  }
}
