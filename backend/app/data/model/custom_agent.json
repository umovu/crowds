{
  "version": 1,
  "about": "An agent a user brings in: parsed from an uploaded document's '# Agents' section, a JSON file, or the manual form. This is the parsed shape (AgentProfile.to_agentsociety_format) stored in project.json custom_agents and seated in sim rooms. Outside data: it is checked every time it is parsed.",
  "stored_in": "uploads/projects/<id>/project.json -> custom_agents[]; sim rooms agentsociety_profiles.json",
  "written_by": [
    "custom_agent_parser.py (_dict_to_profile)",
    "api/graph.py",
    "api/simulation.py"
  ],
  "read_by": [
    "simulation_manager.py",
    "opinion_agent.py",
    "prompt_reframer.py"
  ],
  "rules": [
    "Never a library persona: source_entity_type is custom (parsed from a document or file) or custom_manual (the form).",
    "Long text is capped so one upload cannot flood a prompt.",
    "Fields marked legacy are carried for old documents and not used by current prompts."
  ],
  "fields": {
    "id": {
      "type": "integer",
      "min": 0,
      "when": "always"
    },
    "name": {
      "type": "string",
      "min_length": 1,
      "max_length": 200,
      "when": "always"
    },
    "persona": {
      "type": "string",
      "max_length": 2000,
      "when": "always"
    },
    "background_story": {
      "type": "string",
      "max_length": 6000,
      "when": "always"
    },
    "age": {
      "type": "integer",
      "min": 0,
      "max": 120,
      "nullable": true,
      "when": "always"
    },
    "gender": {
      "type": "string",
      "nullable": true,
      "when": "always"
    },
    "education": {
      "type": "string",
      "nullable": true,
      "when": "always"
    },
    "occupation": {
      "type": "string",
      "nullable": true,
      "when": "always"
    },
    "marriage_status": {
      "type": "string",
      "nullable": true,
      "when": "always"
    },
    "province": {
      "type": "string",
      "nullable": true,
      "when": "always"
    },
    "interested_topics": {
      "type": "list",
      "items": {
        "type": "string"
      },
      "when": "always"
    },
    "group_affiliation": {
      "type": "string",
      "max_length": 500,
      "nullable": true,
      "when": "always"
    },
    "voice_guide": {
      "type": "string",
      "max_length": 3000,
      "nullable": true,
      "when": "always"
    },
    "actor_archetype": {
      "type": "string",
      "nullable": true,
      "when": "always"
    },
    "behavioral_tendencies": {
      "type": "string",
      "max_length": 3000,
      "nullable": true,
      "when": "always"
    },
    "is_institutional": {
      "type": "boolean",
      "when": "optional"
    },
    "is_core_focus": {
      "type": "boolean",
      "when": "optional",
      "legacy": true
    },
    "stance": {
      "type": "string",
      "allowed": [
        "support",
        "neutral",
        "concerned",
        "oppose",
        "resist"
      ],
      "nullable": true,
      "when": "optional"
    },
    "source_entity_uuid": {
      "type": "string",
      "nullable": true,
      "when": "optional",
      "legacy": true
    },
    "source_entity_type": {
      "type": "string",
      "allowed": [
        "custom",
        "custom_manual"
      ],
      "when": "always"
    },
    "created_at": {
      "type": "string",
      "when": "always"
    },
    "needs": {
      "type": "list",
      "items": {
        "type": "object",
        "fields": {
          "need_type": {
            "type": "string",
            "when": "always"
          },
          "intensity": {
            "type": "number",
            "min": 0,
            "max": 100,
            "when": "always"
          }
        }
      },
      "when": "optional",
      "legacy": true
    },
    "attitudes": {
      "type": "list",
      "items": {
        "type": "object",
        "fields": {
          "topic": {
            "type": "string",
            "when": "always"
          },
          "rating": {
            "type": "number",
            "min": 0,
            "max": 10,
            "when": "always"
          },
          "description": {
            "type": "string",
            "when": "always"
          }
        }
      },
      "when": "optional",
      "note": "Author-written 0-10 ratings, not survey stances. Produce no reactions, so the author's voice guide is kept."
    },
    "beliefs": {
      "type": "list",
      "items": {
        "type": "string"
      },
      "when": "optional"
    }
  }
}
