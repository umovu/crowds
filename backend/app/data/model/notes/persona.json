        }
      ],
      "note": "GHS has no industry question, so null on GHS personas.",
      "prompt": {
        "about": [
          "work"
        ],
        "say": "The industry you work in: {value}."
      }
    },
    "marriage_status": {
      "layer": "measured",
      "carried_by": "everyone",
      "source": [
        {
          "survey": "qlfs_2026_q1",
          "items": [
