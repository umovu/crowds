      "note": "QLFS and GHS use different label sets. Both are kept as surveyed.",
      "prompt": {
        "core": true,
        "say": "Marital status: {value}."
      }
    },
    "is_neet": {
      "layer": "measured",
      "carried_by": "everyone",
      "source": [
